# ─── Database ───────────────────────────────────────────────────────────────
# Postgres connection string. Required. Used by Prisma (src/lib/prisma.ts) for
# bookings, customers, vehicles, gallery, services, testimonials, and FAQ.
# Local dev: docker run postgres, or any cloud Postgres (Neon, Supabase, RDS).
# Production: prefer a *pooled* URL (Neon `-pooler`, Supabase port 6543) so
# serverless cold starts don't exhaust connections.
DATABASE_URL=postgresql://user:password@host:5432/rocky_shore_detailing

# ─── Admin auth ─────────────────────────────────────────────────────────────
# JWT signing key for the admin session cookie. Required.
# Generate: `openssl rand -base64 48` (or any 32+ byte random string).
# Used in src/lib/session.ts and src/proxy.ts. NEVER commit the real value.
ADMIN_JWT_SECRET=

# bcrypt hash of the admin login password. Required.
# Generate: `node -e "console.log(require('bcryptjs').hashSync('your-password',12))"`
# (escape any `$` in your shell, or pass via single quotes). Stored as a hash
# so the plaintext password is never in env or git.
ADMIN_PASSWORD_HASH=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Resend API key — sign up at https://resend.com (free tier covers 3,000 emails/month).
# Required for the booking form to actually send mail.
RESEND_API_KEY=

# Where booking submissions are delivered. Defaults to fumarajohn8@gmail.com if unset.
BOOKING_TO_EMAIL=fumarajohn8@gmail.com

# From address. Until you verify your own domain at https://resend.com/domains,
# leave this as Resend's testing sender below.
BOOKING_FROM_EMAIL=Rocky Shore Bookings <onboarding@resend.dev>
