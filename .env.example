# ─── Database ───────────────────────────────────────────────────────────────
# Postgres connection string. Required. Used by Prisma (src/lib/prisma.ts) for
# bookings, customers, vehicles, gallery, services, testimonials, and FAQ.
# Local dev: docker run postgres, or any cloud Postgres (Neon, Supabase, RDS).
# Production: prefer a *pooled* URL (Neon `-pooler`, Supabase port 6543) so
# serverless cold starts don't exhaust connections.
DATABASE_URL=postgresql://postgres:password@localhost:5432/rocky_shore_db
# ─── Supabase ───────────────────────────────────────────────────────────────
# Created at https://supabase.com. Required — used by Supabase Auth (admin
# login) and by the CMS data layer.
NEXT_PUBLIC_SUPABASE_URL=https://qjlzizldulvxlriheqbr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFqbHppemxkdWx2eGxyaWhlcWJyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk5OTc5MjQsImV4cCI6MjA5NTU3MzkyNH0.5OSmj-oOyKFGTeLRXDXCtmD85RBxThEWeeeyqJ8p92o
SUPABASE_SERVICE_ROLE_KEY=sb_secret_ZMvFoIKTyRS_g5IXbqPm0Q_QTsng8f4
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Xf0Fn2XhIi4YJtNcBDeRKw_z4rcoH8G



# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Resend API key — sign up at https://resend.com (free tier covers 3,000 emails/month).
# Required for the booking form to actually send mail.
RESEND_API_KEY=re_BQv4iX6P_4HByjmur9EwmKYvWk1v3wWgh

# Where booking submissions are delivered. Defaults to fumarajohn8@gmail.com if unset.
BOOKING_TO_EMAIL=your_email@example.com

# From address. Until you verify your own domain at https://resend.com/domains,
# leave this as Resend's testing sender below.
BOOKING_FROM_EMAIL=Your Business Name <noreply@example.com>
