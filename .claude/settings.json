{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-env-edits.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/typecheck-on-edit.mjs",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "node .claude/hooks/lint-on-edit.mjs",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node .claude/hooks/test-on-edit.mjs",
            "timeout": 75
          }
        ]
      }
    ]
  }
}
